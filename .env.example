# Токен бота от @BotFather. Обязателен.
BOT_TOKEN=123456789:AAAbbbCCCdddEEEfffGGGhhhIIIjjjKKKlll

# Telegram ID администраторов через запятую. Обязателен, минимум один.
# Админ всегда имеет доступ к Mini App и только он может выдавать доступы через бота.
ADMIN_IDS=123456789

# Публичный HTTPS-адрес, по которому открывается Mini App.
WEBAPP_URL=https://inv.example.com

# Путь к файлу SQLite внутри контейнера. Менять не нужно.
DB_PATH=/data/inventory.db

# Порт, который слушает приложение внутри контейнера.
PORT=8080

# Максимальный возраст initData в секундах (24 часа по умолчанию).
INITDATA_MAX_AGE_SEC=86400

# Запускать ли бота вместе с веб-приложением (нужно для команд выдачи доступа).
BOT_ENABLED=true

# Привязывать ли при старте кнопку меню бота к WEBAPP_URL.
# true — приложение само настроит Menu Button, ручная настройка в BotFather не нужна.
# false — ничего не трогаем, кнопку настраиваешь сам в BotFather.
SET_MENU_BUTTON=true
